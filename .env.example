# Texly Environment Variables
# Copy to .env.local and fill in real values

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# After sign in/up routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/texly?retryWrites=true&w=majority

# Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Admin setup (Optional: specify initial admin email, or first user to register will auto-bootstrap as admin)
# ADMIN_EMAIL=admin@example.com
# Manual MongoDB fallback: db.users.updateOne({ email: "admin@example.com" }, { $set: { isAdmin: true } })
